    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO prod.leads (source, nombre, giro, direccion, geom, telefono, web, score, linea_recomendada, etapa)\nSELECT 'gmaps', nombre, giro, direccion, geom, telefono, web,\n  CASE WHEN web IS NOT NULL AND web <> '' THEN 15 ELSE 0 END +\n  CASE WHEN lower(giro) LIKE '%log%' OR lower(giro) LIKE '%plant%'\n         OR lower(giro) LIKE '%industr%' THEN 20 ELSE 0 END,\n  'evaporativa', 'nuevo'\nFROM stg.leads_raw\nWHERE procesado = false\n  AND NOT EXISTS (\n    SELECT 1 FROM prod.leads l\n    WHERE l.source = 'gmaps'\n      AND lower(l.nombre) = lower(stg.leads_raw.nombre)\n      AND lower(l.direccion) = lower(stg.leads_raw.direccion)\n  );",
        "options": {}
      },
