        "query": "SELECT lead_id AS id, ST_Y(geom) AS lat, ST_X(geom) AS lng, giro, web FROM prod.leads\nWHERE temp_zona IS NULL AND geom IS NOT NULL\nORDER BY lead_id LIMIT 60;",
