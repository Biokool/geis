    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Bonus por temperatura + línea recomendada por mes.\n// $('Leads sin temperatura').item empareja por índice con la respuesta HTTP.\nconst src = $('Leads sin temperatura').item.json;\nconst temp = ($json.current && $json.current.temperature_2m !== undefined)\n  ? $json.current.temperature_2m : null;\nconst giro = String(src.giro || '').toLowerCase();\nconst bonus = (temp !== null && temp > 30) ? 20 : 0;\nconst m = new Date().getMonth(); // 0=ene … 11=dic\nlet linea = 'evaporativa';\nif (m >= 1 && m <= 5) linea = 'koolkat';              // feb–jun: calor\nelse if (m >= 9 || m <= 1) {                          // oct–feb: temporada solar\n  linea = /gasolin|estacionamiento|comercial|plaza|tienda/.test(giro) ? 'solar' : 'evaporativa';\n}\nconst q = (s) => \"'\" + String(s).replace(/'/g, \"''\") + \"'\";\nreturn { json: { id: src.id, temp: temp === null ? 'NULL' : temp, bonus, linea: q(linea) } };\n"
      },
      "id": "7e64e7eb-74be-4b86-892c-4d42be35b4cb",
      "name": "Score y línea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
