    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Empareja por índice con 'Extraer dominio'. 1 crédito Apollo por empresa.\nconst src = $('Extraer dominio').item.json;\nconst org = ($json.organization || $json || {});\nconst emp = org.estimated_num_employees || org.num_employees || null;\nconst bonus = emp >= 200 ? 15 : emp >= 50 ? 10 : 0;\n// empleados como literal SQL ('NULL' o entero) con tope smallint (prod.leads.empleados_est).\nconst nlit = (v) => (v === null || v === undefined || v === '') ? 'NULL' : Math.min(Math.trunc(Number(v) || 0), 32767);\nreturn { json: { id: src.id, empleados: nlit(emp), bonus } };"
      },
