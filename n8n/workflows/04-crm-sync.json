    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Reconstruye los lead_ids exitosos vía pairedItem contra 'Preparar payload'.\nconst oks = $('¿OK?').all();\nconst prep = $('Preparar payload').all();\nconst ids = oks.map(o => {\n  const pi = o.pairedItem;\n  const idx = pi && pi.item !== undefined ? pi.item : null;\n  return (idx !== null && prep[idx]) ? prep[idx].json.lead_id : null;\n}).filter(v => v !== null && v !== undefined);\nif (!ids.length) return [{ query: 'SELECT 1' }];\nreturn [{ query: 'UPDATE prod.leads SET crm_synced_at = now() WHERE lead_id IN (' + ids.map(Number).join(',') + ')' }];"
      },
