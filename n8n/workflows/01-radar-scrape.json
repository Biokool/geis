      "typeVersion": 2,
      "position": [
        200,
        580
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 3 queries x 2 corredores = 6 llamadas al scraper.\nconst queries = ['bodegas', 'centros logísticos', 'plantas industriales'];\nconst locations = ['Toluca, Estado de México', 'Querétaro, Querétaro'];\nconst items = [];\nfor (const q of queries)\n  for (const loc of locations)\n    items.push({ query: q, location: loc, max_results: 40 });\nreturn items;\n"
      },
      "id": "da895b22-43b7-47d6-823f-f822d27b1b13",
      "name": "Armar búsquedas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://scraper:5000/scrape",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 900000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          }
        }
      },
      "id": "226cced7-0c59-4964-823a-15700f919890",
      "name": "Scrapear Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        420
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 15000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aplana la respuesta del scraper. Las cadenas salen entrecomilladas (q)\n// y los números/NULL como literales SQL (n) para el INSERT directo.\n// Dedup dentro del lote por nombre+dirección.\nconst q = (s) => \"'\" + String(s ?? '').replace(/'/g, \"''\") + \"'\";\nconst n = (v) => (v === null || v === undefined || v === '') ? 'NULL' : v;\nconst vistos = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  for (const r of (j.results || [])) {\n    if (!r.nombre) continue;\n    const key = (r.nombre + '|' + (r.direccion || '')).toLowerCase();\n    if (vistos.has(key)) continue;\n    vistos.add(key);\n    out.push({\n      nombre: q(r.nombre), giro: q(j.query), direccion: q(r.direccion),\n      lat: n(r.lat), lng: n(r.lng), telefono: q(r.telefono),\n      web: q(r.web), rating: n(r.rating),\n      fuente: q(j.backend === 'demo' ? 'demo' : 'google_maps'),\n      query: q((j.query || '') + ' ' + (j.location || '')),\n    });\n  }\n}\n// Corrida vacía: si no salió NADA (Google bloqueado / 0 resultados / timeouts)\n// hay que emitir un item marcador igual, o \"Guardar en raw\" y el callback no\n// se ejecutan y la corrida queda en 'running' para siempre en el dashboard.\n// fila=1 -> se inserta; fila=0 -> la sentencia no inserta ninguna fila.\nif (!out.length) {\n  return [{\n    fila: 0, nombre: 'NULL', giro: 'NULL', direccion: 'NULL', lat: 'NULL',\n    lng: 'NULL', telefono: 'NULL', web: 'NULL', rating: 'NULL',\n    fuente: 'NULL', query: \"''\",\n  }];\n}\nreturn out.map((r) => Object.assign({ fila: 1 }, r));\n"
      },
      "id": "7385bc79-a9e5-4fea-8976-c7a3aa26638a",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO stg.leads_raw (nombre, giro, direccion, geom, telefono, web, rating, fuente, query)\nSELECT {{ $json.nombre }}, {{ $json.giro }}, {{ $json.direccion }}, CASE WHEN {{ $json.lat }} IS NULL OR {{ $json.lng }} IS NULL THEN NULL ELSE ST_SetSRID(ST_MakePoint({{ $json.lng }}, {{ $json.lat }}), 4326) END, {{ $json.telefono }}, {{ $json.web }}, {{ $json.rating }}, {{ $json.fuente }}, {{ $json.query }}\nWHERE {{ $json.fila }} = 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "T1a4HFyvCJOItLYP9N87U",
