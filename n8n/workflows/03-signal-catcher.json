        "jsCode": "// Convierte warm_signals al formato del upsert (nombre/giro ya escapados).\nconst q = (s) => \"'\" + String(s ?? '').replace(/'/g, \"''\") + \"'\";\nconst rows = $('Leer warm signals').all().map(i => i.json).filter(r => (r.empresa_ref || '').trim());\nreturn rows.map(r => ({ nombre: q(r.empresa_ref.trim()), giro: q(''),\n  nota: (r.titulo || '') + ' — ' + (r.detalle || '') }));"
