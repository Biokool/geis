    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// El nodo \"Parsear JSON\" (Extract from File) ya dereferenció el binario\n// filesystem-v2 y entregó un item { data: [...] }.\n// Formato: [{empresa, giro, tipo, evidencia, fecha}]\nconst arr = $input.first().json.data || [];\nconst q = (s) => \"'\" + String(s ?? '').replace(/'/g, \"''\") + \"'\";\n// input.json vacío -> un item bandera para no romper la cadena hacia warm_signals.\nif (!arr.length) return [{ _sin_senales: true }];\nreturn arr.map((s) => ({\n  nombre: q(s.empresa),\n  giro: q(s.giro || ''),\n  evidencia: q((s.tipo || '') + ' — ' + (s.evidencia || '')),\n}));\n"
      },
      "id": "3272121c-24af-47fc-8468-bfddefa1bfec",
      "name": "Parsear señales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        420
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH up AS (\n  UPDATE prod.leads\n  SET score = LEAST(score + 25, 100), etapa = 'nuevo', updated_at = now()\n  WHERE lower(nombre) = lower({{ $json.nombre }}) AND lower(direccion) = lower('')\n  RETURNING lead_id\n)\nINSERT INTO prod.leads (source, nombre, giro, direccion, score, etapa, linea_recomendada)\nSELECT 'manual', {{ $json.nombre }}, {{ $json.giro }}, '', 25, 'nuevo', 'evaporativa'\nWHERE NOT EXISTS (SELECT 1 FROM up);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "T1a4HFyvCJOItLYP9N87U",
          "name": "Postgres GEIS"
        }
