      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const html = $input.first().json.data || '';\nconst tok = $('Checar token').first().json.token;\nconst urns = [...new Set(html.match(/urn:li:activity:\\d+/g) || [])].slice(0, 5);\nreturn urns.length ? urns.map(u => ({ urn: u, token: tok })) : [{ urn: '', token: tok }];"
