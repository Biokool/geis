      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Juntar likes').item.json;\nconst total = ($json.paging && $json.paging.total) || 0;\nreturn { json: { urn: src.urn, token: src.token, likes: src.likes, comments: total } };"
      },
      "id": "73d15de0-f9bb-4577-b1c4-bc262254ef8f",
      "name": "Juntar todo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
