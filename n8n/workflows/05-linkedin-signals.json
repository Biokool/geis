      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = ($input.first().json.config) || {};\nconst token = c.access_token || '';\nconst org_id = c.org_id || '';\nconst vanity = c.vanity_name || '';\nconst vigente = !!token && !!vanity && (!c.expires_at || Date.now() < c.expires_at - 60000);\nconst motivo = !token ? 'sin token: conecta en Config → LinkedIn' : (!org_id ? 'falta org_id: Config → Proveedores → linkedin → config.org_id' : (!vanity ? 'falta vanity_name: Config → Proveedores → linkedin → config.vanity_name' : (vigente ? '' : 'token expirado: reconecta en Config → LinkedIn')));\nreturn [{ token, org_id, vanity, vigente, motivo }];"
      },
