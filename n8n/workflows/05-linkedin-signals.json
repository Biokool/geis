      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const posts = $('Juntar todo').all().map(i => i.json).filter(p => p.urn);\nconst segs = $('Stats seguidores').first().json;\nconst prev = ($('Stats previas').all()[0] && $('Stats previas').first().json) || {};\nconst tok = $('Checar token').first().json;\nconst followers = (segs && segs.firstDegreeSize) || 0;\nconst newF = followers - (prev.followers || 0);\nconst eng = posts.reduce((a,p) => a + (p.likes||0) + (p.comments||0), 0);\nconst sig = [];\nif (newF >= 3) sig.push({ t: `LinkedIn: +${newF} seguidores nuevos`, d: `La página pasó de ${prev.followers||0} a ${followers} seguidores. Publica y prospecta esta semana.` });\nposts.forEach(p => { const e = (p.likes||0) + (p.comments||0);\n  if (e >= 5) sig.push({ t: `Post con ${e} interacciones en LinkedIn`, d: `${p.likes} likes + ${p.comments} comentarios: https://www.linkedin.com/feed/update/${encodeURIComponent(p.urn)}. Quienes interactúan son leads cálidos.` }); });\nconst esc = s => String(s ?? '').replace(/'/g, \"''\");\nconst qStats = `INSERT INTO prod.linkedin_stats (org_id, followers, posts_count, engagement_total, stats_date) VALUES ('${esc(tok.org_id)}', ${followers}, ${posts.length}, ${eng}, CURRENT_DATE) ON CONFLICT (org_id, stats_date) DO UPDATE SET followers=EXCLUDED.followers, posts_count=EXCLUDED.posts_count, engagement_total=EXCLUDED.engagement_total;`;\nconst qWarm = sig.length ? `INSERT INTO prod.warm_signals (fuente, titulo, detalle) VALUES ` + sig.map(x => `('linkedin','${esc(x.t)}','${esc(x.d)}')`).join(',') + ';' : 'SELECT 1;';\nreturn [{ query_stats: qStats, query_warm: qWarm, n_signals: sig.length }];"
      },
