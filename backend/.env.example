# GEIS backend — ejemplo de variables de entorno.
# Copiar a .env y llenar. Nunca commitear el .env real.

# Base de datos (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://geis:geis@localhost:5432/geis

# Entorno: development | production
ENVIRONMENT=development
APP_VERSION=1.0.0

# Conector DENUE (INEGI)
DENUE_API_TOKEN=

# IA interna — proveedores con fallback ordenado (solo configura los que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_DEFAULT_ORDER=openai,anthropic,gemini,groq,deepseek,openrouter,nvidia,cloudflare

# Ecosistema GEIS × Radar
N8N_URL=http://n8n:5678
N8N_API_KEY=
SCRAPER_URL=http://scraper:5000

# LinkedIn OAuth (opcional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_ACCESS_TOKEN=
