# GEIS · Plantilla de variables de entorno (desarrollo)
# Copiar a .env antes del primer arranque:  cp .env.example .env
# El .env real NO se commitea (ver .gitignore). Cambia SECRET_KEY y las
# credenciales antes de cualquier despliegue expuesto.

POSTGRES_USER=geis
POSTGRES_PASSWORD=geis_dev
POSTGRES_DB=geis

DATABASE_URL=postgresql+psycopg2://geis:geis_dev@db:5432/geis
REDIS_URL=redis://redis:6379/0

# Token de la API del DENUE (INEGI). Vacío = sin refresco incremental.
DENUE_API_TOKEN=

# Clave de firma JWT. OBLIGATORIO cambiarla en producción.
SECRET_KEY=cambiar-en-produccion

# URL del API para el build del frontend (Vite la incrusta en tiempo de build).
VITE_API_URL=http://localhost:8000

# --- Ecosistema GEIS × Biokool Radar (módulo de ejecución) ---
# URLs internas de Docker (el backend las usa para llamar a n8n y al scraper).
N8N_URL=http://n8n:5678
# API key de n8n: Settings → n8n API (solo si automatizas desde fuera).
N8N_API_KEY=
SCRAPER_URL=http://scraper:5000

# Clave con la que n8n cifra las credenciales guardadas en su UI.
# Genera una única vez (p. ej. 64 chars hex) y NO la cambies luego.
# PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
N8N_ENCRYPTION_KEY=

# LinkedIn OAuth (app con Community Management API; vacías = no configurado).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Token ya emitido (alternativa al flujo OAuth; lo lee /integraciones/linkedin/status).
LINKEDIN_ACCESS_TOKEN=

# --- Credenciales que usan los 5 workflows del radar ---
# Créalas en n8n (http://localhost:5678 → Credentials) con el nombre EXACTO:
#   "Postgres GEIS"  → Postgres: host db, port 5432, database/user/password
#                      = POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD de arriba.
#   "Apollo API"     → Header Auth: name "X-Api-Key", value = APOLLO_API_KEY
#                      (endpoint api.apollo.io/api/v1/organizations/enrich).
#   "HubSpot"        → Header Auth: name "Authorization",
#                      value "Bearer <HUBSPOT_PRIVATE_APP_TOKEN>"
#                      (endpoint api.hubapi.com/crm/v3/objects/companies).
# APIFY_TOKEN lo usa el scraper en modo cloud (01-radar-scrape); el modo
# local de LinkedIn scraping no lo necesita.
APIFY_TOKEN=
APOLLO_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=

# Parámetros generales de la API (ver backend/app/core/config.py).
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
MODEL_VERSION=1.0.0
DENUE_API_BASE_URL=https://www.inegi.org.mx/app/api/denue/v1/consulta

# IA interna — 8 proveedores con cadena de fallback (solo configura los que uses).
# El orden de intento lo define AI_DEFAULT_ORDER. Las keys nunca se exponen al frontend.
OPENAI_API_KEY=<redacted>
ANTHROPIC_API_KEY=<redacted>
GEMINI_API_KEY=<redacted>
GROQ_API_KEY=<redacted>
DEEPSEEK_API_KEY=<redacted>
# OpenRouter (gateway multi-modelo, endpoint compatible OpenAI)
OPENROUTER_API_KEY=<redacted>
OPENROUTER_MODEL=openai/gpt-4o-mini
# NVIDIA NIM (https://build.nvidia.com, endpoint compatible OpenAI)
NVIDIA_API_KEY=<redacted>
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Cloudflare Workers AI (endpoint compatible OpenAI; requiere token Y account ID)
CLOUDFLARE_API_TOKEN=<redacted>
CLOUDFLARE_ACCOUNT_ID=<redacted>
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_DEFAULT_ORDER=openai,anthropic,gemini,groq,deepseek,openrouter,nvidia,cloudflare
